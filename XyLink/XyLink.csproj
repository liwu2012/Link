<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 允许在 Linux/macOS 上交叉编译 Windows 目标，Windows 上无副作用 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 本地 refs/ 目录优先，没有则回退到活字格默认安装路径 -->
    <LocalRefsDir>$(MSBuildThisFileDirectory)refs\</LocalRefsDir>
    <ForguncyBinDir Condition="Exists('$(LocalRefsDir)GrapeCity.Forguncy.Plugin.dll')">$(LocalRefsDir)</ForguncyBinDir>
    <ForguncyBinDir Condition="'$(ForguncyBinDir)' == ''">D:\Program Files\Forguncy 10\Website\bin\</ForguncyBinDir>
    <ForguncyDesignerBinDir Condition="Exists('$(LocalRefsDir)GrapeCity.Forguncy.Plugin.Design.dll')">$(LocalRefsDir)</ForguncyDesignerBinDir>
    <ForguncyDesignerBinDir Condition="'$(ForguncyDesignerBinDir)' == ''">D:\Program Files\Forguncy 10\Website\designerBin\</ForguncyDesignerBinDir>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\Icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Forguncy.Log.Abstractions" Exclude="runtime">
      <HintPath>$(ForguncyBinDir)Forguncy.Log.Abstractions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Forguncy.Commands" Exclude="runtime">
      <HintPath>$(ForguncyBinDir)Forguncy.Commands.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Forguncy.Commands.Design" Exclude="runtime">
      <HintPath>$(ForguncyDesignerBinDir)Forguncy.Commands.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.CellTypes" Exclude="runtime">
      <HintPath>$(ForguncyBinDir)GrapeCity.Forguncy.CellTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.CellTypes.Design" Exclude="runtime">
      <HintPath>$(ForguncyDesignerBinDir)GrapeCity.Forguncy.CellTypes.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.Plugin" Exclude="runtime">
      <HintPath>$(ForguncyBinDir)GrapeCity.Forguncy.Plugin.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.Plugin.Design" Exclude="runtime">
      <HintPath>$(ForguncyDesignerBinDir)GrapeCity.Forguncy.Plugin.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.ServerApi">
      <HintPath>$(ForguncyBinDir)GrapeCity.Forguncy.ServerApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="..\PackageTools\PluginAnalyzer.dll" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="&quot;..\PackageTools\ForguncyPluginPackageTool.exe&quot; &quot;$(ProjectDir).&quot; &quot;$(ProjectDir)$(OutputPath)$(AssemblyName).dll&quot; $(ConfigurationName)" />
  </Target>
</Project>
