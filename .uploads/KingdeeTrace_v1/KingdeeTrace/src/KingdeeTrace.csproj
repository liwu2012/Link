    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- 指向你环境 K3Cloud 网站的 Bin 目录，按实际路径修改 -->
    <K3CloudBin Condition=" '$(K3CloudBin)' == '' ">D:\Program Files (x86)\Kingdee\K3Cloud\WebSite\bin</K3CloudBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Kingdee.BOS">
      <HintPath>$(K3CloudBin)\Kingdee.BOS.dll</HintPath>
